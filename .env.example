# ============================================================================
# UiPath Orchestrator MCP server (Vercel edition) — configuration
# In Vercel: Project → Settings → Environment Variables. Locally: copy to .env.local
# ============================================================================

# ---- Deployment type: "cloud" or "selfhosted" ----
UIPATH_DEPLOYMENT=cloud

# ---- Base URL ----
# Cloud (default if omitted): https://cloud.uipath.com
# Self-hosted / Automation Suite: https://orchestrator.yourcompany.com
UIPATH_BASE_URL=https://cloud.uipath.com

# ---- Org / Tenant ----
# Cloud + Automation Suite: required. Read them from the Orchestrator URL:
#   https://cloud.uipath.com/{ORG_NAME}/{TENANT_NAME}/orchestrator_/
# Classic standalone Orchestrator: leave both blank.
UIPATH_ORG_NAME=yourOrgName
UIPATH_TENANT_NAME=YourTenant

# ---- OAuth (External Application) ----
# Orchestrator → Admin → External Applications → Add Application
#   Type: Confidential application; add Orchestrator API APPLICATION scopes.
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=

# Space-separated scopes (minimum for this server):
UIPATH_SCOPES=OR.Folders.Read OR.Execution OR.Jobs OR.Queues

# Optional: override the token endpoint for unusual topologies.
# Default: {UIPATH_BASE_URL}/identity_/connect/token
# UIPATH_IDENTITY_URL=

# ---- Optional default folder ----
# If set, tools use this when the agent doesn't pass a folderId.
UIPATH_DEFAULT_FOLDER_ID=

# ============================================================================
# MCP endpoint security
# ============================================================================
# Shared secret nuwacom must send as "Authorization: Bearer <token>".
# STRONGLY recommended — this endpoint can start/stop your automations.
MCP_AUTH_TOKEN=
